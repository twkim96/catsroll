[
  {
    "action": "block",
    "description": "Rate limit bots",
    "enabled": true,
    "expression": "(cf.bot_management.verified_bot)",
    "ratelimit": {
      "characteristics": [
        "ip.src",
        "cf.colo.id"
      ],
      "mitigation_timeout": 10,
      "period": 10,
      "requests_per_period": 5
    }
  },
  {
    "action": "block",
    "description": "AI Crawl Control - Block AI bots by User Agent",
    "enabled": true,
    "expression": "(http.request.uri.path ne \"/robots.txt\" and (http.user_agent contains \"meta-externalagent\"))",
    "position": {
      "index": 1
    }
  },
  {
    "action": "block",
    "description": "Block bots accessing /",
    "enabled": false,
    "expression": "(cf.client.bot and http.request.uri.path eq \"/\" and http.request.uri.query contains \"seed=\")"
  }
]
