<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <%- if picked_stat -%>
    <meta name="description" content="<%= meta_description %>">
    <meta name="og:image" content="<%= og_image %>">
    <%- end -%>
    <meta name="viewport" content="width=device-width">
    <link rel="icon" type="image/png" href="/asset/image/treasure.png">
    <link href="/asset/style/tacit.css?<%= self.class.css_digest %>" rel="stylesheet" type="text/css">
    <%= local_partial(:local_head) %>
    <title>Battle Cats Rolls - <%= html_title %></title>
    <style>
      <% case route.theme; when 'mkweb' %>
      /* https://mk.bcgsc.ca/colorblind/img/colorblindness.palettes.v11_4.png */
      :root {
        --rare: white;
        --supa_fest: #00F407; /* radioactive green */
        --supa: #00B408; /* kelly green */
        --uber_fest: #FF9DC8; /* amaranth pink */
        --uber: #EF0096; /* persian rose */
        --legend_fest: #0079FA; /* azure */
        --legend: #8400CD; /* french violet */
        --found: #AFFF2A; /* lime */
        --owned: #7CFFFA; /* eletric blue */
        --exclusive: #00C2F9; /* capri */
      }
      <% when 'alternate' %>
      /* https://mk.bcgsc.ca/colorblind/img/colorblindness.palettes.v11_4.png */
      :root {
        --rare: white;
        --supa_fest: #AFFF2A; /* lime */
        --supa: #FFDC3D; /* gargoyle gas */
        --uber_fest: #FF9DC8; /* amaranth pink */
        --uber: #F60239; /* carmine */
        --legend_fest: #0079FA; /* azure */
        --legend: #8400CD; /* french violet */
        --found: #00F407; /* radioactive green */
        --owned: lightcyan;
        --exclusive: #00E5F8; /* aqua blue */
      }
      <% else %>
      /* https://htmlcolorcodes.com/color-names/ */
      :root {
        --rare: white;
        --supa_fest: yellow;
        --supa: gold;
        --uber_fest: salmon;
        --uber: red;
        --legend_fest: mediumslateblue;
        --legend: darkviolet;
        --found: lime;
        --owned: lightcyan;
        --exclusive: aqua;
      }
      <% end %>

      <%= local_partial(:local_styles) %>
      <% unless show_details %>
        .score, .cat { border-bottom-style: none; }
        .cat { border-top-style: none; }
      <% end %>
      <%= local_partial(:local_utility_styles) %>
    </style>
    <script>
      function roll(element) {
        element.form.submit();
      };
      function pick(position) {
        window.location = '<%= route.uri %>' + '&pick=' + position
          + '#N' + position.replace(/[RGX]/g, '');
      };
    </script>
  </head>
  <body>
    <%= local_partial(:local_body) %>
    <div id="menu">
      <a href="<%= route.uri %>" title="Home / Permalink">
        <img class="menu" src="/asset/image/treasure.png" alt="Treasure"></a>
      <a href="<%= route.cats_uri %>" title="Show me all cats">
        <img class="menu" src="/asset/image/cats.png" alt="Cats"></a>
      <a href="<%= route.help_uri %>" title="Help!">
        <img class="menu" src="/asset/image/help.png" alt="Help"></a>
      <a href="<%= route.logs_uri %>" title="What's changed?">
        <img class="menu" src="/asset/image/logs.png" alt="Logs"></a>
      <a href="<%= route.seek_uri %>" title="Looking for your seed?">
        <img class="menu" src="/asset/image/seek.png" alt="Seek"></a>
    </div>
    <hr>

    <div id="notice" class="section">
    </div>

    <div id="content">
      <%= yield %>
    </div>

    <div id="footer">
      <hr>
      <a href="//<%= route.web_host %>/help">Help</a>
      /
      <a href="https://gitlab.com/godfat/battle-cats-rolls">Source</a>
      &copy;
      2018-2026 Lin Jen-Shin (godfat)
    </div>
  </body>
</html>
