<%= header(1, 'Seed view stats') %>

<style>
  .seed-view-chart {
    display: flex;
    align-items: end;
    gap: 2px;
    height: 12rem;
    max-width: 70rem;
    margin: 1rem 0;
    padding: .5rem;
    border: 1px solid #ddd;
    background: #fafafa;
  }
  .seed-view-bar {
    flex: 1 1 0;
    min-width: 2px;
    background: #3168a8;
  }
  .seed-view-bar-empty {
    background: #ddd;
  }
  .seed-view-summary {
    margin: .5rem 0;
    color: #555;
  }
  .seed-view-days {
    max-width: 24rem;
  }
</style>

<% recent_quarters = arg[:recent_quarters] %>
<% recent_hours = arg[:recent_hours] %>
<% max_quarter = [recent_quarters.map{ |point| point[:count] }.max.to_i, 1].max %>
<% max_hour = [recent_hours.map{ |point| point[:count] }.max.to_i, 1].max %>

<%= header(2, '최근 24시간 (15분 단위)', 'recent-24h') %>
<p class="seed-view-summary">
  Total: <%= recent_quarters.sum{ |point| point[:count] } %>,
  Max: <%= max_quarter %>
</p>
<div class="seed-view-chart" aria-label="Recent 24 hours by 15 minutes">
  <% recent_quarters.each do |point| %>
    <% count = point[:count] %>
    <% height = (count.to_f / max_quarter * 100).round(2) %>
    <div
      class="seed-view-bar <%= 'seed-view-bar-empty' if count.zero? %>"
      style="height: <%= [height, count.zero? ? 1 : 3].max %>%"
      title="<%= point[:label] %>: <%= count %>"></div>
  <% end %>
</div>

<%= header(2, '최근 7일 (1시간 단위)', 'recent-7d') %>
<p class="seed-view-summary">
  Total: <%= recent_hours.sum{ |point| point[:count] } %>,
  Max: <%= max_hour %>
</p>
<div class="seed-view-chart" aria-label="Recent 7 days by hour">
  <% recent_hours.each do |point| %>
    <% count = point[:count] %>
    <% height = (count.to_f / max_hour * 100).round(2) %>
    <div
      class="seed-view-bar <%= 'seed-view-bar-empty' if count.zero? %>"
      style="height: <%= [height, count.zero? ? 1 : 3].max %>%"
      title="<%= point[:label] %>: <%= count %>"></div>
  <% end %>
</div>

<%= header(2, '일별 접속자수', 'daily') %>
<table class="seed-view-days">
  <thead>
    <tr>
      <th>Date</th>
      <th>Views</th>
    </tr>
  </thead>
  <tbody>
    <% arg[:days].each do |day| %>
      <tr>
        <td><%= day[:label] %></td>
        <td><%= day[:count] %></td>
      </tr>
    <% end %>
    <% if arg[:days].empty? %>
      <tr>
        <td colspan="2">No data yet.</td>
      </tr>
    <% end %>
  </tbody>
</table>
