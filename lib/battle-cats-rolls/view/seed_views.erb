<%= header(1, 'Seed view stats') %>

<style>
  .seed-view-grid {
    max-width: 70rem;
  }
  .seed-view-region {
    width: 100%;
    max-width: 70rem;
    table-layout: fixed;
  }
  .seed-view-region th,
  .seed-view-region td {
    min-width: 6rem;
    text-align: center;
  }
  .seed-view-event {
    width: 100%;
    max-width: 70rem;
  }
  .seed-view-event-name {
    font-size: 15px;
  }
  .seed-view-line-chart {
    display: block;
    width: 100%;
    height: auto;
    max-width: 70rem;
    margin: 1rem 0;
    border: 1px solid #ddd;
    background: #fafafa;
  }
  .seed-view-line {
    fill: none;
    stroke: #3168a8;
    stroke-width: 2;
  }
  .seed-view-axis {
    stroke: #ddd;
    stroke-dasharray: 6 3;
    stroke-width: 2;
  }
  .seed-view-axis-tick {
    stroke: #bbb;
    stroke-width: 1;
  }
  .seed-view-axis-label {
    fill: #666;
    font-size: 7px;
    text-anchor: end;
  }
  .seed-view-point {
    fill: #3168a8;
  }
  .seed-view-point-label {
    fill: #333;
    font-size: 8px;
    text-anchor: middle;
  }
  .seed-view-summary {
    margin: .5rem 0;
    color: #555;
  }
  .seed-view-periods {
    width: 100%;
    table-layout: fixed;
  }
</style>

<% recent_quarters = arg[:recent_quarters] %>
<% recent_hours = arg[:recent_hours] %>
<% top_events = arg[:events].select{ |row|
  %w[jp kr].include?(row[:lang])
}.first(10) %>
<% max_quarter = [recent_quarters.map{ |point| point[:count] }.max.to_i, 1].max %>
<% max_hour = [recent_hours.map{ |point| point[:count] }.max.to_i, 1].max %>

<div class="seed-view-grid">
  <%= header(2, '지역별 검색', 'regions') %>
  <table class="seed-view-region">
    <% if arg[:langs].empty? %>
      <tbody>
        <tr>
          <td>No data yet.</td>
        </tr>
      </tbody>
    <% else %>
      <thead>
        <tr>
          <% arg[:langs].each do |row| %>
            <th><%= seed_view_region_label(row[:key]) %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <tr>
          <% arg[:langs].each do |row| %>
            <td><%= row[:count] %></td>
          <% end %>
        </tr>
      </tbody>
    <% end %>
  </table>

  <%= header(2, '이벤트 Top 10 (KR/JP)', 'events') %>
  <table class="seed-view-event">
    <thead>
      <tr>
        <th>Rank</th>
        <th>Region</th>
        <th>Event</th>
        <th>Views</th>
      </tr>
    </thead>
    <tbody>
      <% top_events.each.with_index(1) do |row, rank| %>
        <tr>
          <td><%= rank %></td>
          <td><%= seed_view_region_label(row[:lang]) %></td>
          <td class="seed-view-event-name">
            <%= seed_view_event_name(row[:lang], row[:event]) %>
          </td>
          <td><%= row[:count] %></td>
        </tr>
      <% end %>
      <% if top_events.empty? %>
        <tr>
          <td colspan="4">No data yet.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= header(2, '최근 24시간 (15분 단위)', 'recent-24h') %>
<p class="seed-view-summary">
  Total: <%= recent_quarters.sum{ |point| point[:count] } %>,
  Max: <%= max_quarter %>
</p>
<%= seed_view_line_chart(recent_quarters, axis_every: 4, axis_label: :time) %>

<%= header(2, '최근 7일 (1시간 단위)', 'recent-7d') %>
<p class="seed-view-summary">
  Total: <%= recent_hours.sum{ |point| point[:count] } %>,
  Max: <%= max_hour %>
</p>
<%= seed_view_line_chart(recent_hours, axis_every: 24, axis_label: :date) %>

<%= header(2, '접속자수 요약', 'periods') %>
<table class="seed-view-periods">
  <thead>
    <tr>
      <th>Day</th>
      <th>Cnt</th>
      <th>Week</th>
      <th>Cnt</th>
      <th>mo.</th>
      <th>Cnt</th>
    </tr>
  </thead>
  <tbody>
    <% periods_empty = arg[:days].empty? && arg[:weeks].empty? && arg[:months].empty? %>
    <% rows = periods_empty ? 0 : 7 %>
    <% rows.times do |index| %>
      <% day = arg[:days][index] %>
      <% week = arg[:weeks][index] %>
      <% month = arg[:months][index] %>
      <tr>
        <td><%= day && day[:label] %></td>
        <td><%= day && day[:count] %></td>
        <td><%= week && week[:label] %></td>
        <td><%= week && week[:count] %></td>
        <td><%= month && month[:label] %></td>
        <td><%= month && month[:count] %></td>
      </tr>
    <% end %>
    <% if periods_empty %>
      <tr>
        <td colspan="6">No data yet.</td>
      </tr>
    <% end %>
  </tbody>
</table>
