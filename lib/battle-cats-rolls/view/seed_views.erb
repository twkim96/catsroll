<%= header(1, 'Seed view stats') %>

<style>
  .seed-view-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-start;
  }
  .seed-view-region {
    width: 14rem;
  }
  .seed-view-event {
    max-width: 56rem;
  }
  .seed-view-event-name {
    font-size: 15px;
  }
  .seed-view-line-chart {
    display: block;
    width: 100%;
    height: auto;
    max-width: 70rem;
    margin: 1rem 0;
    border: 1px solid #ddd;
    background: #fafafa;
  }
  .seed-view-line {
    fill: none;
    stroke: #3168a8;
    stroke-width: 2;
  }
  .seed-view-axis {
    stroke: #ddd;
    stroke-dasharray: 6 3;
    stroke-width: 2;
  }
  .seed-view-point {
    fill: #3168a8;
  }
  .seed-view-point-label {
    fill: #333;
    font-size: 8px;
    text-anchor: middle;
  }
  .seed-view-summary {
    margin: .5rem 0;
    color: #555;
  }
  .seed-view-days {
    max-width: 24rem;
  }
</style>

<% recent_quarters = arg[:recent_quarters] %>
<% recent_hours = arg[:recent_hours] %>
<% top_events = arg[:events].select{ |row|
  %w[jp kr].include?(row[:lang])
}.first(10) %>
<% max_quarter = [recent_quarters.map{ |point| point[:count] }.max.to_i, 1].max %>
<% max_hour = [recent_hours.map{ |point| point[:count] }.max.to_i, 1].max %>

<div class="seed-view-grid">
  <div>
    <%= header(2, '지역별 검색', 'regions') %>
    <table class="seed-view-region">
      <thead>
        <tr>
          <th>Region</th>
          <th>Views</th>
        </tr>
      </thead>
      <tbody>
        <% arg[:langs].each do |row| %>
          <tr>
            <td><%= seed_view_region_label(row[:key]) %></td>
            <td><%= row[:count] %></td>
          </tr>
        <% end %>
        <% if arg[:langs].empty? %>
          <tr>
            <td colspan="2">No data yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div>
    <%= header(2, '이벤트 Top 10', 'events') %>
    <table class="seed-view-event">
      <thead>
        <tr>
          <th>Rank</th>
          <th>Region</th>
          <th>Event</th>
          <th>Views</th>
        </tr>
      </thead>
      <tbody>
        <% top_events.each.with_index(1) do |row, rank| %>
          <tr>
            <td><%= rank %></td>
            <td><%= seed_view_region_label(row[:lang]) %></td>
            <td class="seed-view-event-name">
              <%= seed_view_event_name(row[:lang], row[:event]) %>
            </td>
            <td><%= row[:count] %></td>
          </tr>
        <% end %>
        <% if top_events.empty? %>
          <tr>
            <td colspan="4">No data yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%= header(2, '최근 24시간 (15분 단위)', 'recent-24h') %>
<p class="seed-view-summary">
  Total: <%= recent_quarters.sum{ |point| point[:count] } %>,
  Max: <%= max_quarter %>
</p>
<%= seed_view_line_chart(recent_quarters) %>

<%= header(2, '최근 7일 (1시간 단위)', 'recent-7d') %>
<p class="seed-view-summary">
  Total: <%= recent_hours.sum{ |point| point[:count] } %>,
  Max: <%= max_hour %>
</p>
<%= seed_view_line_chart(recent_hours) %>

<%= header(2, '일별 접속자수', 'daily') %>
<table class="seed-view-days">
  <thead>
    <tr>
      <th>Date</th>
      <th>Views</th>
    </tr>
  </thead>
  <tbody>
    <% arg[:days].each do |day| %>
      <tr>
        <td><%= day[:label] %></td>
        <td><%= day[:count] %></td>
      </tr>
    <% end %>
    <% if arg[:days].empty? %>
      <tr>
        <td colspan="2">No data yet.</td>
      </tr>
    <% end %>
  </tbody>
</table>
