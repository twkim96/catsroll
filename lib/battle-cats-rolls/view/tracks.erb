<%= erb :form %>
<%= erb :information %>

<% if arg %>
  <%= erb :found_cats %>
  <%= erb :table %>
  <%= erb :table_notes %>
<% elsif route.event_missing_data? %>
  <p>Data only available in v<%= gacha.pool.version %>+</p>
<% else %>
  <%= self.class.descriptions['/'] %>

  <p>Check the <a href="<%= h route.help_uri %>">help page</a> for more details.</p>
<% end %>
