#top_utility {
  position: absolute;
  right: 8px;
  top: 8px;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 4px;
}
#top_utility a {
  padding: 2px 6px;
  border: 1px solid #ddd;
  border-radius: 4px;
  background: rgba(255, 255, 255, .9);
  color: #555;
  font-size: 12px;
  line-height: 1.2;
  text-decoration: none;
  text-align: center;
}
#top_utility a:hover {
  text-decoration: underline;
}
