<div class="found_cats">
  <%= local_partial(:local_found_prompt) %>
  <% if arg[:found_cats].any? %>
    <p>Found cats:</p>
  <% end %>
  <ul>
    <% arg[:found_cats].each do |cat| %>
      <li>
        <span class="<%= cat.score_rarity_label %>">
          <%= link_to_roll(cat) %>
        </span>:
        <%= found_cat_numbers(cat) %>
      </li>
    <% end %>
  </ul>
</div>
