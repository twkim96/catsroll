<div class="found_cats">
  <p class="multi_track_prompt">
    <a href="<%= route.multi_uri %>">멀티 트랙 보기: PC 권장</a>
  </p>
  <% if arg[:found_cats].any? %>
    <p>Found cats:</p>
  <% end %>
  <ul>
    <% arg[:found_cats].each do |cat| %>
      <li>
        <span class="<%= cat.rarity_label %>">
          <%= link_to_roll(cat) %>
        </span>:
        <%= found_cat_numbers(cat) %>
      </li>
    <% end %>
  </ul>
</div>
