<div class="found_cats">
  <% found, exclusive = found_and_exclusive_cats %>
  <% if found %>
    <p>Found cats:</p>
    <%= erb :found_cats_listing, cats: found %>
  <% end %>
  <% if exclusive.any? %>
    <p>Exclusive and legend cats:</p>
    <%= erb :found_cats_listing, cats: exclusive %>
  <% end %>
</div>
