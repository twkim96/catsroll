<section id="multi-track-app" class="multi-track-app"
  data-find-worker="/asset/multi-find-worker.js?<%= self.class.multi_find_worker_digest %>"
  data-find-engine="/asset/multi-find-engine.js?<%= self.class.multi_find_engine_digest %>">
  <link rel="stylesheet" href="/asset/multi-find.css?<%= self.class.multi_find_css_digest %>">
  <div class="multi-hero">
    <div>
      <p class="multi-kicker">Local multi</p>
      <h1>Multi Track</h1>
    </div>
    <div class="multi-summary" id="multi_summary"></div>
  </div>

  <p id="multi_share_notice" class="multi-share-notice" hidden>
    공유 링크로 연 임시 세션입니다. 여기서 수정해도 기존 브라우저 설정은 바뀌지 않습니다.
  </p>

  <form id="multi_form" class="multi-controls" autocomplete="off">
    <label>
      <span>Seed</span>
      <input id="multi_seed" name="seed" inputmode="numeric" pattern="[0-9]*">
    </label>
    <label>
      <span>Count</span>
      <input id="multi_count" name="count" type="number" min="1" max="500">
    </label>
    <label>
      <span>Last roll</span>
      <input id="multi_last" name="last" type="number" min="0" inputmode="numeric" pattern="[0-9]*" title="Last rolled cat ID">
    </label>
    <label class="multi-last-readout">
      <span>kr / jp</span>
      <input id="multi_last_hint" class="multi-last-hint" readonly tabindex="-1" aria-label="kr / jp last roll interpretation">
    </label>
    <button id="multi_apply" class="multi-apply" type="submit">Apply</button>
  </form>

  <section class="multi-find-panel" aria-label="경로 검색 설정">
    <div class="multi-find-controls">
      <button id="multi_find_filter" class="multi-find-filter" type="button"
        aria-haspopup="dialog" aria-controls="multi_find_dialog"
        aria-label="목표 캐릭터 선택">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path d="M4 5h16l-6.5 7.2v5.3l-3 1.5v-6.8z"></path>
        </svg>
        <span id="multi_find_count" hidden>0</span>
      </button>
      <label>
        <span>검색 기준</span>
        <select id="multi_find_optimization">
          <option value="cost" selected>최소코스트</option>
          <option value="distance">최단거리</option>
          <option value="balance">균형</option>
        </select>
      </label>
      <label>
        <span>확뽑 최대</span>
        <input id="multi_find_max_guaranteed" type="number" min="0" max="20" value="0">
      </label>
      <label>
        <span>플래티넘 최대</span>
        <input id="multi_find_max_platinum" type="number" min="0" max="99" value="0">
      </label>
      <label>
        <span>레전드티켓 최대</span>
        <input id="multi_find_max_legend_ticket" type="number" min="0" max="99" value="0">
      </label>
      <label class="multi-find-summary-field">
        <span>선택한 캐릭터</span>
        <input id="multi_find_targets" type="text" readonly
          role="button" aria-haspopup="dialog"
          aria-controls="multi_find_dialog"
          aria-label="선택한 캐릭터 필터 열기"
          placeholder="필터 버튼에서 캐릭터를 선택하세요.">
      </label>
      <button id="multi_find_help" class="multi-find-help" type="button"
        aria-haspopup="dialog" aria-controls="multi_find_help_dialog"
        aria-label="검색 기준 설명">?</button>
    </div>
  </section>

  <div class="multi-list-panel">
    <div id="multi_rows" class="multi-rows"></div>
    <button id="multi_add" class="multi-add-row" type="button" aria-label="Add track">+</button>
  </div>
  <div id="multi_notice" class="multi-notice" role="status"></div>
  <details id="multi_found" class="multi-found">
    <summary>Found cats</summary>
    <div id="multi_found_cats" class="multi-found-content"></div>
  </details>
  <section id="multi_find_result" class="multi-find-result" hidden
    aria-live="polite"></section>
  <div id="multi_tables" class="multi-tables"></div>

  <dialog id="multi_find_dialog" class="event-filter-dialog multi-find-dialog"
    aria-labelledby="multi_find_dialog_title">
    <div class="event-filter-backdrop" data-multi-find-backdrop
      aria-hidden="true"></div>
    <div class="event-filter-panel">
      <div class="event-filter-header">
        <h2 id="multi_find_dialog_title">목표 캐릭터</h2>
        <button type="button" class="event-filter-close"
          data-multi-find-close aria-label="닫기">&times;</button>
      </div>

      <div class="event-filter-search-wrap">
        <label for="multi_find_search">캐릭터 검색</label>
        <input id="multi_find_search" type="search"
          placeholder="한국어명, 일본어명, 캐릭터 ID">
      </div>

      <div class="event-filter-section event-filter-selected-section"
        role="group" aria-labelledby="multi_find_selected_title">
        <div class="event-filter-selected-toolbar">
          <h3 id="multi_find_selected_title">선택한 캐릭터</h3>
          <button type="button" class="event-filter-reset"
            data-multi-find-reset>초기화</button>
        </div>
        <div id="multi_find_selected" class="multi-find-selected"></div>
        <p id="multi_find_selected_empty" class="event-filter-empty">
          선택한 캐릭터가 없습니다.</p>
      </div>

      <div class="event-filter-section event-filter-series-section"
        role="group" aria-labelledby="multi_find_available_title">
        <h3 id="multi_find_available_title">캐릭터</h3>
        <p class="multi-find-catalog-note">
          현재 선택한 이벤트에 포함된 캐릭터가 먼저 표시됩니다.</p>
        <div id="multi_find_available" class="event-filter-tags"></div>
        <p id="multi_find_no_results" class="event-filter-empty" hidden>
          검색 결과가 없습니다.</p>
      </div>
    </div>
  </dialog>

  <dialog id="multi_find_help_dialog"
    class="event-filter-dialog multi-find-help-dialog"
    aria-labelledby="multi_find_help_title">
    <div class="event-filter-backdrop" data-multi-find-help-backdrop
      aria-hidden="true"></div>
    <div class="event-filter-panel">
      <div class="event-filter-header">
        <h2 id="multi_find_help_title">검색 기준 안내</h2>
        <button type="button" class="event-filter-close"
          data-multi-find-help-close aria-label="닫기">&times;</button>
      </div>
      <div class="multi-find-help-content">
        <dl>
          <dt>최소코스트</dt>
          <dd>목표를 모두 얻는 경로 중 유료 재화 점수가 가장 낮은 경로입니다.
            동점이면 더 짧은 경로를 선택합니다.</dd>
          <dt>최단거리</dt>
          <dd>목표를 모두 얻은 뒤의 도착 위치가 가장 앞선 경로입니다.
            동점이면 코스트가 낮은 경로를 선택합니다.</dd>
          <dt>균형</dt>
          <dd>최소코스트를 기준으로, 경로에서 얻는 울슈레마다 0.2점,
            레전드레어마다 2점을 빼서 좋은 고등급 획득을 가볍게 우대합니다.</dd>
        </dl>
        <p>기본 점수: 레어티켓 1회 0.03 · 확뽑 1회 1 ·
          플래티넘/레전드 티켓 1회 2</p>
        <p>각 최대 횟수는 검색 중 넘을 수 없는 사용 한도입니다.</p>
      </div>
    </div>
  </dialog>

  <dialog id="multi_event_filter_dialog" class="event-filter-dialog"
    aria-labelledby="multi_event_filter_title">
    <div class="event-filter-backdrop" data-multi-filter-backdrop
      aria-hidden="true"></div>
    <div class="event-filter-panel">
      <div class="event-filter-header">
        <h2 id="multi_event_filter_title">시리즈 필터</h2>
        <button type="button" class="event-filter-close"
          data-multi-filter-close aria-label="닫기">&times;</button>
      </div>

      <div class="event-filter-search-wrap">
        <label for="multi_event_filter_search">시리즈 검색</label>
        <input id="multi_event_filter_search" type="search"
          placeholder="이벤트명, 캐릭터명, 시리즈 ID">
      </div>

      <div class="event-filter-section event-filter-selected-section"
        role="group" aria-labelledby="multi_event_filter_selected_title">
        <div class="event-filter-selected-toolbar">
          <h3 id="multi_event_filter_selected_title">선택한 태그</h3>
          <button type="button" class="event-filter-reset"
            data-multi-filter-reset>초기화</button>
        </div>
        <div class="event-filter-tags" data-multi-filter-selected></div>
        <p class="event-filter-empty" data-multi-filter-selected-empty>
          선택한 필터가 없습니다.</p>
      </div>

      <div class="event-filter-section event-filter-series-section"
        role="group" aria-labelledby="multi_event_filter_series_title">
        <h3 id="multi_event_filter_series_title">시리즈</h3>
        <p class="event-filter-status" data-multi-filter-status
          role="status" aria-live="polite">불러오는 중…</p>
        <div class="event-filter-tags" data-multi-filter-available></div>
        <p class="event-filter-empty" data-multi-filter-no-results hidden>
          검색 결과가 없습니다.</p>
      </div>
    </div>
  </dialog>

  <script id="multi_track_data" type="application/json"><%= json_script(arg[:multi_data]) %></script>
  <script src="/asset/track-engine.js" defer></script>
  <script src="/asset/multi-share.js?<%= self.class.multi_share_digest %>" defer></script>
  <script src="/asset/multi-track.js?<%= self.class.multi_track_digest %>" defer></script>
  <script src="/asset/multi-find.js?<%= self.class.multi_find_digest %>" defer></script>
</section>

<style>
  .multi-track-app {
    --multi-ink: #1d1d1f;
    --multi-muted: #6e6e73;
    --multi-line: #d2d2d7;
    --multi-panel: #ffffff;
    --multi-soft: #f5f5f7;
    --multi-soft-2: #fbfbfd;
    --multi-accent: #0071e3;
    --multi-warn: #d93025;
    width: 100%;
    max-width: 1200px;
    color: var(--multi-ink);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text",
      "Helvetica Neue", Arial, sans-serif;
  }
  .multi-hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .85rem;
    margin: .9rem 0 1.05rem;
    padding: .15rem 0 .8rem;
    border-bottom: 1px solid var(--multi-line);
  }
  .multi-share-notice {
    box-sizing: border-box;
    margin: 0 0 1rem;
    padding: .65rem .8rem;
    border: 1px solid #9dc5ee;
    border-radius: 7px;
    background: #eef6ff;
    color: #244d7e;
    font-size: .82rem;
    font-weight: 600;
  }
  .multi-kicker {
    margin: 0 0 .2rem;
    color: var(--multi-accent);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .multi-hero h1 {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.12;
    letter-spacing: 0;
  }
  .multi-summary {
    color: var(--multi-muted);
    font-size: .8rem;
    font-weight: 600;
    text-align: right;
    white-space: nowrap;
  }
  .multi-controls,
  .multi-row {
    display: grid;
    gap: .65rem;
    align-items: end;
  }
  .multi-controls {
    grid-template-columns: minmax(8rem, .85fr) 4.8rem 5rem minmax(16rem, 1.25fr) 4.8rem;
    margin-bottom: .75rem;
    padding: .72rem .85rem .82rem;
    border: 1px solid var(--multi-line);
    border-radius: 8px;
    background: var(--multi-soft);
  }
  .multi-list-panel {
    margin-bottom: .35rem;
    padding: .6rem .7rem .7rem;
    border: 1px solid var(--multi-line);
    border-radius: 8px;
    background: var(--multi-soft);
  }
  .multi-row {
    grid-template-columns: 1.55rem 1.55rem 4.05rem minmax(16rem, 1fr) 3.4rem 11rem;
    margin-bottom: .45rem;
    padding: .45rem .35rem .5rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
  }
  .multi-controls label,
  .multi-last-readout,
  .multi-row label {
    display: grid;
    gap: .25rem;
    margin: 0;
  }
  .multi-last-readout {
    align-self: end;
  }
  .multi-controls span,
  .multi-row span {
    color: var(--multi-muted);
    font-size: .74rem;
    font-weight: 700;
  }
  .multi-controls input,
  .multi-last-hint,
  .multi-row input,
  .multi-row select {
    box-sizing: border-box;
    width: 100%;
    min-height: 2rem;
    margin: 0;
    padding: .15rem 0 .05rem;
    border: 0;
    border-bottom: 1px solid var(--multi-ink);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .multi-controls input,
  .multi-last-hint {
    color: var(--multi-ink);
    font-family: inherit;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.2;
  }
  .multi-apply {
    box-sizing: border-box;
    min-height: 2rem;
    margin: 0;
    padding: .25rem .7rem;
    border: 1px solid var(--multi-accent);
    border-radius: 8px;
    background: var(--multi-accent);
    color: var(--multi-panel);
    font-size: .8rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .multi-apply:hover,
  .multi-apply:focus-visible {
    filter: brightness(.95);
  }
  .multi-apply:disabled {
    border-color: var(--multi-line);
    background: var(--multi-soft-2);
    color: var(--multi-muted);
    filter: none;
  }
  .multi-last-hint {
    overflow-wrap: anywhere;
  }
  .multi-row select[data-field="event"],
  .multi-row input[data-field="customName"] {
    font-size: .85rem;
  }
  .multi-row button {
    width: 1.35rem;
    min-height: 2rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--multi-warn);
    line-height: 0;
  }
  .multi-row button:hover {
    background: rgba(217, 48, 37, .08);
  }
  .multi-row button:disabled {
    color: var(--multi-warn);
    opacity: .45;
  }
  .multi-row button svg {
    width: .95rem;
    height: .95rem;
    stroke: currentColor;
  }
  .multi-row .multi-filter-button {
    position: relative;
    width: 1.35rem;
    border: 1px solid transparent;
    color: var(--multi-muted);
  }
  .multi-row .multi-filter-button:hover,
  .multi-row .multi-filter-button.is-active {
    border-color: var(--multi-accent);
    background: #eaf2fa;
    color: var(--multi-accent);
  }
  .multi-row .multi-filter-button .event-filter-count {
    top: -7px;
    right: -9px;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
  }
  .multi-add-row {
    display: block;
    width: 100%;
    min-height: 2rem;
    margin: .15rem 0 0;
    border: 1px solid var(--multi-line);
    border-radius: 8px;
    background: var(--multi-soft);
    color: var(--multi-muted);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1;
  }
  .multi-add-row:hover {
    border-color: var(--multi-accent);
    color: var(--multi-accent);
  }
  .multi-notice {
    min-height: 1.25rem;
    margin: .4rem 0 .8rem;
    color: var(--multi-warn);
    font-size: .9rem;
  }
  .multi-notice.is-action {
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .multi-notice.is-action:focus-visible {
    outline: 2px solid var(--multi-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .multi-found {
    margin: .2rem 0 .9rem;
  }
  .multi-found summary {
    display: flex;
    align-items: center;
    gap: .4rem;
    width: max-content;
    margin: 0 0 .4rem;
    color: var(--multi-muted);
    cursor: pointer;
    font-size: .86rem;
    font-weight: 700;
    letter-spacing: 0;
    list-style: none;
  }
  .multi-found summary::-webkit-details-marker {
    display: none;
  }
  .multi-found summary::before {
    display: inline-grid;
    place-items: center;
    width: 1.05rem;
    height: 1.05rem;
    border: 1px solid var(--multi-line);
    border-radius: 3px;
    background: var(--multi-soft-2);
    color: var(--multi-muted);
    content: "+";
    font-size: .9rem;
    line-height: 1;
  }
  .multi-found[open] summary::before {
    content: "−";
  }
  .multi-found summary:focus-visible {
    outline: 2px solid var(--multi-accent);
    outline-offset: 3px;
    border-radius: 3px;
  }
  .multi-found-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: .55rem .85rem;
    padding: .65rem .75rem;
    border: 1px solid var(--multi-line);
    border-radius: 8px;
    background: var(--multi-soft-2);
  }
  .multi-found-group {
    min-width: 0;
  }
  .multi-found-group h3 {
    margin: 0 0 .25rem;
    color: var(--multi-muted);
    font-size: .76rem;
    font-weight: 700;
  }
  .multi-found-group ul {
    margin: 0 0 0 1.2rem;
  }
  .multi-found-group li {
    margin: .12rem 0;
    font-size: .76rem;
    line-height: 1.35;
  }
  .multi-found-group a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .multi-found-empty,
  .multi-found-loading {
    margin: 0;
    color: var(--multi-muted);
    font-size: .76rem;
  }
  .multi-track-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .85rem;
    align-items: start;
    margin-top: .9rem;
  }
  .multi-track-section {
    width: auto;
    max-width: none;
    margin-right: 0;
    margin-left: 0;
    min-width: 0;
  }
  .multi-track-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    min-height: 1.4rem;
    margin: 0 0 .4rem;
  }
  .multi-track-section h2 {
    margin: 0;
    color: var(--multi-muted);
    font-size: .86rem;
    font-weight: 700;
    letter-spacing: 0;
  }
  .multi-track-scroll-controls {
    display: flex;
    align-items: center;
    gap: .28rem;
    color: var(--multi-muted);
    font-size: .7rem;
    font-weight: 700;
  }
  .multi-track-scroll-controls span {
    min-width: 4.6rem;
    text-align: center;
    white-space: nowrap;
  }
  .multi-track-scroll-controls button {
    display: inline-grid;
    place-items: center;
    width: 1.35rem;
    min-height: 1.35rem;
    margin: 0;
    padding: 0;
    border: 1px solid var(--multi-line);
    border-radius: 5px;
    background: var(--multi-soft-2);
    color: var(--multi-muted);
    font-size: 1rem;
    line-height: 1;
  }
  .multi-track-scroll-controls button:hover,
  .multi-track-scroll-controls button:focus-visible {
    border-color: var(--multi-accent);
    color: var(--multi-accent);
  }
  .multi-track-scroll-controls button:disabled {
    border-color: var(--multi-line);
    color: var(--multi-line);
    cursor: default;
  }
  .multi-table-wrap {
    overflow: visible;
    border: 1px solid var(--multi-line);
    border-radius: 8px;
    background: var(--multi-panel);
  }
  #multi_tables.is-track-paged {
    overflow-x: clip;
  }
  .multi-track-pair.is-scrollable {
    position: relative;
    width: calc(200% + .85rem);
    max-width: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    transition: transform .24s ease;
    will-change: transform;
  }
  .multi-track-pair.is-scrollable .multi-track-section {
    min-width: 0;
  }
  .multi-track-table {
    width: 100%;
    min-width: 0;
    margin: 0;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .multi-track-table th,
  .multi-track-table td {
    border: 1px solid var(--multi-line);
    padding: .35rem .45rem;
    vertical-align: top;
    font-size: .78rem;
    line-height: 1.25;
    overflow: visible;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: keep-all;
  }
  .multi-track-table th {
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--multi-soft);
    background-clip: padding-box;
    box-shadow: 0 1px 0 var(--multi-line);
    color: var(--multi-ink);
  }
  .multi-track-app.is-ipad .multi-track-table th {
    position: static;
    box-shadow: none;
  }
  .multi-track-table th:first-child,
  .multi-track-table td:first-child {
    width: 3rem;
