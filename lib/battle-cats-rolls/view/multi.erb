<section id="multi-track-app" class="multi-track-app">
  <div class="multi-hero">
    <div>
      <p class="multi-kicker">Local multi</p>
      <h1>Multi Track</h1>
    </div>
    <div class="multi-summary" id="multi_summary"></div>
  </div>

  <form id="multi_form" class="multi-controls" autocomplete="off">
    <label>
      <span>Seed</span>
      <input id="multi_seed" name="seed" inputmode="numeric" pattern="[0-9]*">
    </label>
    <label>
      <span>Count</span>
      <input id="multi_count" name="count" type="number" min="1" max="500">
    </label>
    <label>
      <span>Last roll</span>
      <input id="multi_last" name="last" type="number" min="0" inputmode="numeric" pattern="[0-9]*" title="Last rolled cat ID">
    </label>
    <label class="multi-last-readout">
      <span>kr / jp</span>
      <input id="multi_last_hint" class="multi-last-hint" readonly tabindex="-1" aria-label="kr / jp last roll interpretation">
    </label>
    <button id="multi_apply" class="multi-apply" type="submit">Apply</button>
  </form>

  <div class="multi-list-panel">
    <div id="multi_rows" class="multi-rows"></div>
    <button id="multi_add" class="multi-add-row" type="button" aria-label="Add track">+</button>
  </div>
  <div id="multi_notice" class="multi-notice" role="status"></div>
  <div id="multi_tables" class="multi-tables"></div>

  <script id="multi_track_data" type="application/json"><%= json_script(arg[:multi_data]) %></script>
  <script src="/asset/track-engine.js" defer></script>
  <script src="/asset/multi-track.js?<%= self.class.multi_track_digest %>" defer></script>
</section>

<style>
  .multi-track-app {
    --multi-ink: #1d1d1f;
    --multi-muted: #6e6e73;
    --multi-line: #d2d2d7;
    --multi-panel: #ffffff;
    --multi-soft: #f5f5f7;
    --multi-soft-2: #fbfbfd;
    --multi-accent: #0071e3;
    --multi-warn: #d93025;
    width: 100%;
    max-width: 1200px;
    color: var(--multi-ink);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text",
      "Helvetica Neue", Arial, sans-serif;
  }
  .multi-hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .85rem;
    margin: .9rem 0 1.05rem;
    padding: .15rem 0 .8rem;
    border-bottom: 1px solid var(--multi-line);
  }
  .multi-kicker {
    margin: 0 0 .2rem;
    color: var(--multi-accent);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .multi-hero h1 {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.12;
    letter-spacing: 0;
  }
  .multi-summary {
    color: var(--multi-muted);
    font-size: .8rem;
    font-weight: 600;
    text-align: right;
    white-space: nowrap;
  }
  .multi-controls,
  .multi-row {
    display: grid;
    gap: .65rem;
    align-items: end;
  }
  .multi-controls {
    grid-template-columns: minmax(8rem, .85fr) 4.8rem 5rem minmax(16rem, 1.25fr) 4.8rem;
    margin-bottom: .75rem;
    padding: .72rem .85rem .82rem;
    border: 1px solid var(--multi-line);
    border-radius: 8px;
    background: var(--multi-soft);
  }
  .multi-list-panel {
    margin-bottom: .35rem;
    padding: .6rem .7rem .7rem;
    border: 1px solid var(--multi-line);
    border-radius: 8px;
    background: var(--multi-soft);
  }
  .multi-row {
    grid-template-columns: 1.55rem 4.05rem minmax(19.8rem, 1fr) 3.4rem 6.5rem;
    margin-bottom: .45rem;
    padding: .45rem .35rem .5rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
  }
  .multi-controls label,
  .multi-last-readout,
  .multi-row label {
    display: grid;
    gap: .25rem;
    margin: 0;
  }
  .multi-last-readout {
    align-self: end;
  }
  .multi-controls span,
  .multi-row span {
    color: var(--multi-muted);
    font-size: .74rem;
    font-weight: 700;
  }
  .multi-controls input,
  .multi-last-hint,
  .multi-row input,
  .multi-row select {
    box-sizing: border-box;
    width: 100%;
    min-height: 2rem;
    margin: 0;
    padding: .15rem 0 .05rem;
    border: 0;
    border-bottom: 1px solid var(--multi-ink);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .multi-controls input,
  .multi-last-hint {
    color: var(--multi-ink);
    font-family: inherit;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.2;
  }
  .multi-apply {
    box-sizing: border-box;
    min-height: 2rem;
    margin: 0;
    padding: .25rem .7rem;
    border: 1px solid var(--multi-accent);
    border-radius: 8px;
    background: var(--multi-accent);
    color: var(--multi-panel);
    font-size: .8rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .multi-apply:hover,
  .multi-apply:focus-visible {
    filter: brightness(.95);
  }
  .multi-apply:disabled {
    border-color: var(--multi-line);
    background: var(--multi-soft-2);
    color: var(--multi-muted);
    filter: none;
  }
  .multi-last-hint {
    overflow-wrap: anywhere;
  }
  .multi-row select[data-field="event"] {
    font-size: .85rem;
  }
  .multi-row button {
    width: 1.35rem;
    min-height: 2rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--multi-warn);
    line-height: 0;
  }
  .multi-row button:hover {
    background: rgba(217, 48, 37, .08);
  }
  .multi-row button:disabled {
    color: var(--multi-warn);
    opacity: .45;
  }
  .multi-row button svg {
    width: .95rem;
    height: .95rem;
    stroke: currentColor;
  }
  .multi-add-row {
    display: block;
    width: 100%;
    min-height: 2rem;
    margin: .15rem 0 0;
    border: 1px solid var(--multi-line);
    border-radius: 8px;
    background: var(--multi-soft);
    color: var(--multi-muted);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1;
  }
  .multi-add-row:hover {
    border-color: var(--multi-accent);
    color: var(--multi-accent);
  }
  .multi-notice {
    min-height: 1.25rem;
    margin: .4rem 0 .8rem;
    color: var(--multi-warn);
    font-size: .9rem;
  }
  .multi-notice.is-action {
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .multi-notice.is-action:focus-visible {
    outline: 2px solid var(--multi-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .multi-track-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .85rem;
    align-items: start;
    margin-top: .9rem;
  }
  .multi-track-section {
    min-width: 0;
  }
  .multi-track-section h2 {
    margin: 0 0 .4rem;
    color: var(--multi-muted);
    font-size: .86rem;
    font-weight: 700;
    letter-spacing: 0;
  }
  .multi-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--multi-line);
    border-radius: 8px;
    background: var(--multi-panel);
  }
  .multi-track-table {
    width: 100%;
    min-width: 0;
    margin: 0;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .multi-track-table th,
  .multi-track-table td {
    border: 1px solid var(--multi-line);
    padding: .35rem .45rem;
    vertical-align: top;
    font-size: .78rem;
    line-height: 1.25;
    overflow: visible;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: keep-all;
  }
  .multi-track-table th {
    background: var(--multi-soft);
    color: var(--multi-ink);
  }
  .multi-track-table th:first-child,
  .multi-track-table td:first-child {
    width: 3rem;
    text-align: center;
    white-space: nowrap;
  }
  .multi-cat-name {
    display: block;
    overflow-wrap: anywhere;
  }
  .multi-track-table a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .multi-cat-next,
  .multi-cat-guaranteed {
    display: block;
    margin-top: .18rem;
    color: var(--multi-muted);
    font-size: .74rem;
  }
  .multi-cat-switch {
    box-shadow: inset 3px 0 0 var(--multi-accent);
  }
  @media (max-width: 820px) {
    .multi-hero {
      align-items: start;
      flex-direction: column;
    }
    .multi-summary {
      text-align: left;
      white-space: normal;
    }
    .multi-controls,
    .multi-row {
      grid-template-columns: 1fr;
    }
    .multi-row button {
      width: 100%;
    }
    .multi-track-pair {
      grid-template-columns: minmax(0, 1fr);
    }
    .multi-track-table {
      min-width: 0;
    }
  }
</style>
