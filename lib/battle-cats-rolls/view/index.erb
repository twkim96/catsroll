<%= erb :form %>

<% if gacha.pool.exist? %>
  <div id="client-compute" class="note">
    <label title="Compute and render the tracks in your browser instead of on the server">
      <input type="checkbox" id="client-compute-toggle">
      내 기기 연산
    </label>
    <span id="client-compute-status"></span>
    <a href="#" id="client-compute-clear" title="Unregister the offline service worker and clear its cache">캐시 제거</a>
  </div>
<% end %>

<% if arg %>
  <%= erb :found_cats %>
  <%= erb :information %>
  <%= erb :table %>
  <%= erb :table_notes %>
<% end %>

<% unless gacha.pool.exist? %>
  <p>Data only available in v<%= gacha.pool.version %>+</p>
<% end %>

<% if gacha.pool.exist? %>
  <script src="/asset/track-data.js" defer></script>
  <script src="/asset/track-engine.js" defer></script>
  <script src="/asset/track-render.js" defer></script>
  <script src="/asset/track-client.js" defer></script>
<% end %>
