<div class="note"><ul>
  <li><%= erb :help_seek %></li>
  <li>There are <%= arg[:queue_size] %> people waiting for their seeds.</li>
</ul></div>

<div class="form">
  <form method="post" action="//<%= route.seek_host %>/seek/enqueue"
    enctype="application/x-www-form-urlencoded"
    data-rates="<%= route.seek_rates.join(' ') %>"
    data-slots="<%= route.seek_slots.join(' ') %>"
    data-track-base="<%= route.uri %>">
    <label for="seeker_select">Seeker:</label>
    <select id="seeker_select" name="seeker">
      <option value="VampireFlower" <%= selected_seeker('VampireFlower') %>>VampireFlower</option>
    </select>

    <fieldset class="compute">
      <legend>Compute (검색 위치):</legend>
      <label>
        <input type="radio" name="compute" value="server" checked="checked">
        서버 연산 (Server)
      </label>
      <label>
        <input type="radio" name="compute" value="client">
        내 기기 연산 (My device)
      </label>
    </fieldset>

    <ol>
      <% 10.times do %>
        <li>
          <select name="rolls">
            <option value="" selected="selected">Pick your roll</option>

            <optgroup label="Rare:">
              <%= pick_option(gacha.rare_cats) %>
            </optgroup>

            <optgroup label="Super:">
              <%= pick_option(gacha.supa_cats) %>
            </optgroup>

            <optgroup label="Uber:">
              <%= pick_option(gacha.uber_cats) %>
            </optgroup>

            <optgroup label="Legendary:">
              <%= pick_option(gacha.legend_cats) %>
            </optgroup>
          </select>
        </li>
      <% end %>
    </ol>

    <%= hidden_inputs 'event', 'lang', 'name' %>
    <input type="submit" value="Seek">
  </form>
</div>

<div id="client-seek-result" class="note"></div>

<script type="text/javascript" src="/asset/seek-client.js"></script>
